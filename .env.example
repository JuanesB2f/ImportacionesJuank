# Públicas (navegador) — las que ya tienes
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo servidor (opcional al inicio; necesaria para imports/admin que bypass RLS)
# Project Settings → API Keys → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Storage
SUPABASE_STORAGE_BUCKET=product-images

# Shopify Admin API (Dev Dashboard → Settings)
SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com
# Misma tienda, expuesta al navegador (links al Admin)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Scopes necesarios (app → reinstalar tras cambiar):
# write_products, write_inventory, write_files, write_publications,
# write_discounts, read_discounts, read_locations

# En Netlify: Site settings → Environment variables
# (mismas claves; nunca subas .env.local al repo)

